{
  "name": "flamesense",
  "version": "1.0.0",
  "private": true,
  "description": "Wildfire spread visualisation. The site itself is dependency-free static files; Node is used only for the test suite and the data tooling.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "validate": "node tools/validate-data.mjs",
    "extract": "node tools/extract-data.mjs",
    "check": "npm run validate && npm test",
    "serve": "node --run serve:python",
    "serve:python": "python3 -m http.server 8000 --directory public"
  },
  "engines": {
    "node": ">=18"
  }
}
